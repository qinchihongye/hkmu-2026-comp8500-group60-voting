# 仓库唯一的环境配置示例。复制为根目录 .env 后填写，不提交 .env。
# 三个消费方各自只读自己需要的变量，互不干扰：
#   - 后端：backend/src/main/python/config/server_config.py
#   - 数据库：db/compose.yml（通过 docker compose --env-file .env 做插值）
#   - 前端：frontend/vite.config.ts（Vite 开发代理）

# ── 后端 ──────────────────────────────────────────────
# 宿主机直连地址；docker 模式下 compose 会把主机名覆盖成 postgres 服务名。
DATABASE_URL=postgresql+psycopg://voting:change-me@127.0.0.1:5432/voting
TEST_DATABASE_URL=postgresql+psycopg://voting:change-me@127.0.0.1:5433/voting_test
# 列表按 JSON 解析。普通逗号字符串会在校验前失败。
# 填浏览器访问地址：本机 docker 是 http://localhost:8188（Nginx 8188 端口），服务器改成实际域名/IP。
ALLOWED_ORIGINS=["http://localhost:8188"]
PUBLIC_BASE_URL=http://localhost:8188
SESSION_TTL_HOURS=8
GUEST_TTL_DAYS=30
POLL_ACCESS_TTL_MINUTES=60
COOKIE_SECURE=false
ANON_VOTER_HMAC_KEY=6a4bb40115f15fae598ca478d5c16e0b9985db5949fb1b1255b03fa93ceb3d66
IDENTITY_FINGERPRINT_HMAC_KEY=b4a92c3d5e7f1029384756abcdef0123456789abcdef0123456789abcdef0123
DEMO_ADMIN_PASSWORD=comp8500sefgroup60
DEMO_USER_PASSWORD=comp8500sefgroup60
DEMO_VOTER_PASSWORD=comp8500sefgroup60
DEMO_POLL_PASSWORD=comp8500sefgroup60
# 固定示例目录。应用配置默认关闭。本仓库 Compose 在未设置时当作 true，
# 所以 docker compose up 会补齐缺失示例。false 只隐藏 Overview 示例区和目录接口，不删除投票。
DEMO_POLLS_ENABLED=true

# ── 数据库 ────────────────────────────────────────────
POSTGRES_USER=voting
POSTGRES_PASSWORD=comp8500sef
POSTGRES_DB=voting
TEST_POSTGRES_DB=voting_test

# 投票文字识别默认关闭。不要把真实密钥写进仓库。
# 开启时 POLL_TEXT_PARSE_ENABLED=true，并填写 OPENAI_API_KEY 和 POLL_TEXT_PARSE_MODEL。
# OPENAI_BASE_URL 可空，空则使用 SDK 默认地址。DeepSeek 兼容地址是 https://api.deepseek.com。
# POLL_TEXT_PARSE_TIMEOUT_SECONDS 范围为 1 到 60。
# POLL_TEXT_PARSE_THINKING 可空，或为 enabled / disabled。空则请求不带 thinking。
# POLL_TEXT_PARSE_REASONING_EFFORT 可空，或为 none / low / high / max 等。空则不带该字段。
# POLL_TEXT_PARSE_STREAM 为本次模型请求是否流式。识别只读取一次完整 JSON，请保持 false。
# POLL_TEXT_PARSE_RESPONSE_FORMAT 为 json_schema 或 json_object。
# DeepSeek 当前不支持 json_schema，使用 deepseek-flash 时填 json_object。
POLL_TEXT_PARSE_MODEL=
POLL_TEXT_PARSE_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
POLL_TEXT_PARSE_TIMEOUT_SECONDS=20
POLL_TEXT_PARSE_THINKING=
POLL_TEXT_PARSE_REASONING_EFFORT=
POLL_TEXT_PARSE_STREAM=false
POLL_TEXT_PARSE_RESPONSE_FORMAT=json_schema

# ── 前端 ──────────────────────────────────────────────
# 浏览器只请求同源 /api/v1。这个值只给 Vite 开发代理使用。
VITE_API_PROXY=http://127.0.0.1:8000